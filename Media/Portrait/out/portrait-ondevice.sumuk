// 초상 — 온디바이스(Vision) 구조 + DCT 하프톤 톤. canvas 비율 a = 0.7500
canvas 354 × 472
ink #141414 width 0.5

circles k = 1 ... 7000 {
  center ( 0.0185·√k·cos(φk), 0.0185·√k·sin(φk) )
  radius  0.012 · D(0.0185·√k·cos(φk), 0.0185·√k·sin(φk))^1.6
}
where φ = π(3 − √5)

// silhouette — 현 가족
segments k = 1 ... 900 {
  from ( x1(2πk/900), y1(2πk/900) )
  to   ( x1(2π(k+40)/900), y1(2π(k+40)/900) )
}
// faceContour — 붓 원 가족
circles k = 1 ... 500 {
  center ( x2(2πk/500), y2(2πk/500) )
  radius  0.004 + 0.006·|sin(9·2πk/500)|
}
// leftEyebrow — 곡선
curve t ∈ [0, π] samples 300 { x = x3(t)  y = y3(t) }
// rightEyebrow — 곡선
curve t ∈ [0, π] samples 300 { x = x4(t)  y = y4(t) }
// leftEye — 현 가족
segments k = 1 ... 160 {
  from ( x5(2πk/160), y5(2πk/160) )
  to   ( x5(2π(k+14)/160), y5(2π(k+14)/160) )
}
// rightEye — 현 가족
segments k = 1 ... 160 {
  from ( x6(2πk/160), y6(2πk/160) )
  to   ( x6(2π(k+14)/160), y6(2π(k+14)/160) )
}
// nose — 곡선
curve t ∈ [0, π] samples 300 { x = x7(t)  y = y7(t) }
// noseCrest — 곡선
curve t ∈ [0, π] samples 300 { x = x8(t)  y = y8(t) }
// outerLips — 현 가족
segments k = 1 ... 220 {
  from ( x9(2πk/220), y9(2πk/220) )
  to   ( x9(2π(k+18)/220), y9(2π(k+18)/220) )
}
// innerLips — 곡선
curve t ∈ [0, π] samples 300 { x = x10(t)  y = y10(t) }
// leftPupil — 붓 원 가족
circles k = 1 ... 60 {
  center ( x11(2πk/60), y11(2πk/60) )
  radius  0.006 + 0.004·|sin(4·2πk/60)|
}
// rightPupil — 붓 원 가족
circles k = 1 ... 60 {
  center ( x12(2πk/60), y12(2πk/60) )
  radius  0.006 + 0.004·|sin(4·2πk/60)|
}
// contour0 — 현 가족
segments k = 1 ... 500 {
  from ( x13(2πk/500), y13(2πk/500) )
  to   ( x13(2π(k+25)/500), y13(2π(k+25)/500) )
}
// contour1 — 현 가족
segments k = 1 ... 500 {
  from ( x14(2πk/500), y14(2πk/500) )
  to   ( x14(2π(k+25)/500), y14(2π(k+25)/500) )
}
// contour2 — 현 가족
segments k = 1 ... 500 {
  from ( x15(2πk/500), y15(2πk/500) )
  to   ( x15(2π(k+25)/500), y15(2π(k+25)/500) )
}
// contour3 — 현 가족
segments k = 1 ... 500 {
  from ( x16(2πk/500), y16(2πk/500) )
  to   ( x16(2π(k+25)/500), y16(2π(k+25)/500) )
}
// contour4 — 현 가족
segments k = 1 ... 500 {
  from ( x17(2πk/500), y17(2πk/500) )
  to   ( x17(2π(k+25)/500), y17(2π(k+25)/500) )
}
// contour5 — 현 가족
segments k = 1 ... 500 {
  from ( x18(2πk/500), y18(2πk/500) )
  to   ( x18(2π(k+25)/500), y18(2π(k+25)/500) )
}

