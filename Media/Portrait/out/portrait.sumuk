// 초상 (portrait) — 고전 파이프라인 결과. canvas 비율 a = 0.7500
canvas 354 × 472
ink #141414 width 0.5

// 톤: Vogel 나선 하프톤 (원 7,000개, 반지름 = DCT 농담 급수)
circles k = 1 ... 7000 {
  center ( 0.0185·√k·cos(φk), 0.0185·√k·sin(φk) )
  radius  0.012 · D(0.0185·√k·cos(φk), 0.0185·√k·sin(φk))^1.6
}
where φ = π(3 − √5)

// 등고선 1 (명도 0.22) — 현 가족, 조화 10개
